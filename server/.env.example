# Copy to server/.env — NOT to the repo root.
#
# The server loads its environment with `import 'dotenv/config'`, which
# resolves `.env` against the process working directory. Every path into the
# server (`npm run dev:server`, `npm run db:init`) does `cd server` first, so
# `server/.env` is the only file it reads. A `.env` at the repo root is read
# by nothing.
#
# The client is separate: Vite reads `client/.env` (its own root — no envDir
# is configured). It needs no file in development; see VITE_WS_URL in the
# README if you want to point it at a non-default server.

# Database. Relative paths resolve against server/, so this lands at
# server/data/joseki.db.
DATABASE_PATH=./data/joseki.db

# Every model call — chat and workflow prompt nodes — goes through OpenRouter
# (https://openrouter.ai/keys); it is the only provider. Without a key the
# editor still works, the chat routes answer 503 and a run fails before its
# first prompt node.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development
