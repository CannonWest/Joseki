{
  "name": "@maestroai/server",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/db/init.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "smoke:chat": "tsx scripts/chat-smoke.ts"
  },
  "dependencies": {
    "@maestroai/shared": "file:../shared",
    "better-sqlite3": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expr-eval": "^2.0.2",
    "express": "^4.18.2",
    "handlebars": "^4.7.8",
    "openai": "^4.28.0",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
