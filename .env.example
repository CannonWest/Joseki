# Database
DATABASE_PATH=./data/maestroai.db

# API Keys (encrypt at rest in production)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...

# Chat runs through OpenRouter (https://openrouter.ai/keys). Without a key the
# workflow editor still works; chat is disabled.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Server
PORT=3001
NODE_ENV=development

# WebSocket
WS_PATH=/socket.io

# Client
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
